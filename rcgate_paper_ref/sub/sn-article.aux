\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.1.1}Stage 1: Metadata Isolation Barrier and Gating Network}{12}{subsubsection.54}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detailed architectural schematic of RC-Gate. The gating network observes exclusively metadata ($t, g$), isolated from verification signals by a non-leakage barrier. Specialist linear experts score signal vectors independently into unconstrained logits ($z_{\mathrm  {cross}}, z_{\mathrm  {evid}}$). Logits are modulated by dynamic routing weights $(w_{\mathrm  {cross}}, w_{\mathrm  {evid}})$ and fused via stacked meta-learner $\Phi $. The glass-box output returns both the risk score $\hat  {p}$ and explicit attribution weights.}}{13}{figure.53}\protected@file@percent }
\newlabel{fig:arch}{{1}{13}{Detailed architectural schematic of RC-Gate. The gating network observes exclusively metadata ($t, g$), isolated from verification signals by a non-leakage barrier. Specialist linear experts score signal vectors independently into unconstrained logits ($z_{\mathrm {cross}}, z_{\mathrm {evid}}$). Logits are modulated by dynamic routing weights $(w_{\mathrm {cross}}, w_{\mathrm {evid}})$ and fused via stacked meta-learner $\Phi $. The glass-box output returns both the risk score $\hat {p}$ and explicit attribution weights}{figure.53}{}}
