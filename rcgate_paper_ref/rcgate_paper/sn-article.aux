\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mathematical notation employed in the RC-Gate architecture, signal extraction pipeline, and evaluation protocols.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:notation}{{2}{10}{Mathematical notation employed in the RC-Gate architecture, signal extraction pipeline, and evaluation protocols}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detailed architectural schematic of RC-Gate. The gating network observes exclusively metadata ($t, g$), isolated from verification signals by a non-leakage barrier. Specialist linear experts score signal vectors independently into unconstrained logits ($z_{\mathrm  {cross}}, z_{\mathrm  {evid}}$). Logits are modulated by dynamic routing weights $(w_{\mathrm  {cross}}, w_{\mathrm  {evid}})$ and fused via stacked meta-learner $\Phi $. The glass-box output returns both the risk score $\hat  {p}$ and explicit attribution weights.}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{10}{Detailed architectural schematic of RC-Gate. The gating network observes exclusively metadata ($t, g$), isolated from verification signals by a non-leakage barrier. Specialist linear experts score signal vectors independently into unconstrained logits ($z_{\mathrm {cross}}, z_{\mathrm {evid}}$). Logits are modulated by dynamic routing weights $(w_{\mathrm {cross}}, w_{\mathrm {evid}})$ and fused via stacked meta-learner $\Phi $. The glass-box output returns both the risk score $\hat {p}$ and explicit attribution weights}{figure.1}{}}
